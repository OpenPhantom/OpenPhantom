# The style rules the tree is held to, applied by the editor before a line is saved. The C rules
# in legacy/CONTRIBUTING.md say the same things; this is the copy an editor reads.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# Carried upstream files are kept byte for byte; see .gitattributes.
[installer/dist/**]
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = false
