# A shell script with CRLF endings fails on Linux with "bad interpreter: /bin/sh^M", so
# these keep LF whatever the checkout platform is. Listed FIRST so the installer/dist rule
# below still wins there, where nothing is converted at all.
*.sh text eol=lf

# Everything the installer carries is preserved byte for byte. core.autocrlf would rewrite the
# line endings of upstream licence texts and readmes on checkout, so the files people receive
# would no longer match what their authors published, and no checksum recorded against them
# would hold.
installer/dist/** -text
installer/source/** -text
