# title: The destroyer droid
# about: Attack for destroyr.baf alone, the shape of the game's own "dest" script (FEDSHIP,
# about: FINAL, ASSAULT, QUEEN, GARDEN, SWAMP): rolls at the player on its roll clip, unfolds
# about: within two and a half units, widens its cylinder and raises the shield (extra_func 2,
# about: the fxshield on the body), fires the twin muzzles while they stay within seven units,
# about: and folds and rolls again when they leave. While the shield is up every hit is refunded
# about: three hit points, as the game's does, until it is down to 25, when the shield hides
# about: and hits count in full. The clips are this one model's: 0 stand, 1 fire, 2 roll,
# about: 3 unfold, 5 fold, 6 die, so nothing here is a placeholder. Extra Func always branches,
# about: so each one is written as the game writes them, an if whose block continues.
# about: Dies folded, on its own death clip, and fades eight seconds later.
script "drdk":
    if check_death():
        set_ai_mode(4)
        mode_jmp()
    if chk_for_hit(0):
        if chk_count(4, 0, 0):
            set_hit_pnts(1, 3)
            if hit_points(2, 25):
                set_count(4, 1)
                if extra_func(4, 0, 0f):
                    mode_jmp()
                mode_jmp()
            mode_jmp()
        mode_jmp()
    mode_jmp()

mode "roll":
    if range_check(0, 2, 2.5f):
        move_speed(0f)
        set_ai_mode(1)
        end_cycle()
    move_speed(3.5f)
    when move_to(3, 2, 0.5f) completes:
        end_cycle()
    end_cycle()

mode "unfo":
    when animation(0, 3, 0) completes:
        set_cylinder(0.4f, 0.8f)
        set_count(4, 0)
        if extra_func(2, 0, 0f):
            set_ai_mode(2)
            end_cycle()
        set_ai_mode(2)
        end_cycle()
    end_cycle()

mode "fire":
    if range_check(0, 2, 7.0f):
        shootemup(2, 0, 0, 1)
        end_cycle()
    set_ai_mode(3)
    end_cycle()

mode "fold":
    set_count(4, 1)
    if extra_func(3, 0, 0f):
        continue()
    when animation(0, 5, 0) completes:
        set_cylinder(0.25f, 0.8f)
        set_ai_mode(0)
        end_cycle()
    end_cycle()

mode "die":
    if extra_func(3, 0, 0f):
        continue()
    when animation(0, 6, 0) completes:
        start_timer()
        set_ai_mode(5)
        end_cycle()
    end_cycle()

mode "gone":
    if check_timer(1, 8.0f):
        ai_killed(0)
        end_cycle()
    end_cycle()
