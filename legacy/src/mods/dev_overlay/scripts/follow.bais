# title: Follow the player
# about: Walks after the player and stops within a unit and a half, standing and facing them
# about: until they are three units off, then walks again: two thresholds, since one made a
# about: follower stutter between walking and standing while the player walked slowly on the
# about: line (played 2026-09-16). The walk clip is the file's own, found by name when the copy
# about: is raised; clip 1 stands in for it here. Dies with its own death clip and fades.
script "folw":
    if check_death():
        set_ai_mode(1)
        mode_jmp()
    mode_jmp()

mode "folw":
    if range_check(0, 2, 1.5f):
        set_ai_mode(3)
        end_cycle()
    move_speed(3.0f)
    when move_to(3, 1, 1.5f) completes:
        end_cycle()
    end_cycle()

mode "die":
    when animation(0, 30, 0) completes:
        start_timer()
        set_ai_mode(2)
        end_cycle()
    end_cycle()

mode "gone":
    if check_timer(1, 8.0f):
        ai_killed(0)
        end_cycle()
    end_cycle()

mode "near":
    if range_check(0, 2, 3.0f):
        move_speed(0.0f)
        when move_to(3, 0, 0.5f) completes:
            end_cycle()
        end_cycle()
    set_ai_mode(0)
    end_cycle()
