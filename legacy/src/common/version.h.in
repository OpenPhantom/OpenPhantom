/* version.h: the one place the project's version number exists in the C tree.
 *
 * Generated by CMake from version.h.in. The number itself lives in the top level CMakeLists.txt
 * beside the comment that says which digit moves, and the installer's own AppVer is kept in step
 * with it by hand, because Inno cannot read a CMake variable and a build system that reached into
 * the installer would couple two things that are otherwise independent.
 *
 * Do not edit the generated copy. It sits in the build directory and is overwritten on configure.
 */
#ifndef COMMON_VERSION_H
#define COMMON_VERSION_H

/* The three-digit number as a string, for anything that prints it. */
#define OPENPHANTOM_VERSION "@OPENPHANTOM_VERSION@"

/* The same number as four integers, for the binary FILEVERSION field a version resource needs.
 * The fourth is always zero: three digits is what this project versions with. */
#define OPENPHANTOM_VERSION_MAJOR @OPENPHANTOM_VERSION_MAJOR@
#define OPENPHANTOM_VERSION_MINOR @OPENPHANTOM_VERSION_MINOR@
#define OPENPHANTOM_VERSION_PATCH @OPENPHANTOM_VERSION_PATCH@

#endif /* COMMON_VERSION_H */
